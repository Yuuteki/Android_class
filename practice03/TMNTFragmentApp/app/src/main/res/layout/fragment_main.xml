<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/choose_turtle"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/turtle_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_leo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/leo_label" />

            <RadioButton
                android:id="@+id/radio_don"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/don_label" />

            <RadioButton
                android:id="@+id/radio_raph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/raph_label" />

            <RadioButton
                android:id="@+id/radio_mike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mike_label" />
        </RadioGroup>

        <ImageButton
            android:id="@+id/turtle_image"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/image_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/tmntleo" />

        <TextView
            android:id="@+id/turtle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tap_hint"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
